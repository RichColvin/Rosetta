            <child>
              <!-- Tab strip only - both pages are empty. Each tab's own
                   widgets stay directly in MainGrid, one GtkStack per
                   cell (Mode_Stack_<column>_<row>, "idx"/"sync" pages),
                   so both tabs share MainGrid's rows and stay aligned
                   with each axis's letter/ENA/Feed Rate/Device, and
                   (GtkStack always sizing to its larger page) nothing
                   moves when switching - see Panel_Mode_Switch in
                   Rosetta_main.py. -->
              <object class="GtkNotebook" id="Panel_Mode_Tabs">
                <property name="visible">True</property>
                <property name="can-focus">True</property>
                <property name="valign">end</property>
                <property name="show-border">False</property>
                <signal name="switch-page" handler="Panel_Mode_Switch" swapped="no"/>
                <child>
                  <object class="GtkBox" id="Panel_Mode_Page_Idx">
                    <property name="visible">True</property>
                    <property name="can-focus">False</property>
                  </object>
                </child>
                <child type="tab">
                  <object class="GtkLabel" id="Panel_Mode_Tab_Idx">
                    <property name="visible">True</property>
                    <property name="can-focus">False</property>
                    <property name="label" translatable="yes">Indexing</property>
                    <attributes>
                      <attribute name="font-desc" value="DejaVu Serif 12"/>
                      <attribute name="weight" value="bold"/>
                    </attributes>
                  </object>
                  <packing>
                    <property name="tab-fill">False</property>
                  </packing>
                </child>
                <child>
                  <object class="GtkBox" id="Panel_Mode_Page_Sync">
                    <property name="visible">True</property>
                    <property name="can-focus">False</property>
                  </object>
                  <packing>
                    <property name="position">1</property>
                  </packing>
                </child>
                <child type="tab">

                <property name="can-focus">False</property>
                <property name="halign">center</property>
                <property name="valign">center</property>
                <property name="button-text">ENA</property>
                <property name="dual-color">True</property>
                <property name="font-off-color"/>
                <property name="font-on-color"/>
                <property name="is-momentary">True</property>
                <property name="light-off-color">#ffff00000000</property>
                <property name="light-on-color">#0000ffff0000</property>
                <signal name="clicked" handler="Sp0_Set_Ena" swapped="no"/>
              </object>
              <packing>
                <property name="left-attach">1</property>
                <property name="top-attach">7</property>
              </packing>
            </child>
            <child>
              <object class="HAL_LightButton" id="Sp1_ENA">
                <property name="visible">True</property>
                <property name="can-focus">False</property>
                <property name="halign">center</property>
                <property name="valign">center</property>
                <property name="margin-left">2</property>
                <property name="margin-right">2</property>
                <property name="margin-top">2</property>
                <property name="margin-bottom">2</property>
                <property name="button-text">ENA</property>
                <property name="dual-color">True</property>
                <property name="font-off-color"/>
                <property name="font-on-color"/>
                <property name="is-momentary">True</property>
                <property name="light-off-color">#ffff00000000</property>
                <property name="light-on-color">#0000ffff0000</property>
                <signal name="clicked" handler="Sp1_Set_Ena" swapped="no"/>
              </object>
              <packing>
                <property name="left-attach">1</property>
                <property name="top-attach">8</property>
              </packing>
            </child>
            <child>
              <object class="HAL_Button" id="Sp0_Move_Rev">
                <property name="visible">True</property>
                <property name="can-focus">True</property>
                <property name="receives-default">True</property>
                <property name="halign">center</property>
                <property name="valign">center</property>
                <property name="image">Image_Rev</property>
                <property name="use-underline">True</property>
                <property name="image-position">top</property>
                <signal name="pressed" handler="Sp0_Move_Rev" swapped="no"/>
              </object>
              <packing>
                <property name="left-attach">8</property>
                <property name="top-attach">7</property>
              </packing>
            </child>
            <child>
              <object class="HAL_Button" id="Sp0_Move_Fwd">
                <property name="visible">True</property>
                <property name="can-focus">True</property>
                <property name="receives-default">True</property>

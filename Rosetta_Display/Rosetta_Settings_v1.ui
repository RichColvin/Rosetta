                                  <object class="GtkViewport">
                                    <property name="visible">True</property>
                                    <property name="can-focus">False</property>
                                    <property name="shadow-type">none</property>
                                    <child>
                                      <object class="GtkBox">
                                        <property name="visible">True</property>
                                        <property name="can-focus">False</property>
                                        <property name="orientation">vertical</property>
                                        <child>
                                          <object class="GtkLabel">
                                            <property name="visible">True</property>
                                            <property name="can-focus">False</property>
                                            <property name="halign">start</property>
                                            <property name="valign">start</property>
                                            <property name="hexpand">True</property>
                                            <property name="label" translatable="yes">Spindle Notes</property>
                                            <property name="justify">center</property>
                                            <attributes>
                                              <attribute name="font-desc" value="DejaVu Serif 16"/>
                                              <attribute name="weight" value="bold"/>
                                              <attribute name="foreground" value="#1a1a5f5fb4b4"/>
                                            </attributes>
                                          </object>
                                          <packing>
                                            <property name="expand">False</property>
                                            <property name="fill">True</property>
                                            <property name="position">0</property>
                                          </packing>
                                        </child>
                                        <child>
                                          <object class="GtkLabel">
                                            <property name="visible">True</property>
                                            <property name="can-focus">False</property>
                                            <property name="halign">start</property>
                                            <property name="valign">center</property>
                                            <property name="label" translatable="yes">When you wish to drive the spindle and rosette phaser/multiplier, there are two options.
</property>
                                            <property name="wrap">True</property>
                                            <attributes>
                                              <attribute name="font-desc" value="DejaVu Serif 10"/>
                                            </attributes>
                                          </object>
                                          <packing>
                                            <property name="expand">False</property>
                                            <property name="fill">True</property>
                                            <property name="position">1</property>
                                          </packing>
                                        </child>
                                        <child>
                                          <object class="GtkLabel">
                                            <property name="visible">True</property>
                                            <property name="can-focus">False</property>
                                            <property name="halign">start</property>
                                            <property name="valign">start</property>
                                            <property name="hexpand">True</property>
                                            <property name="label" translatable="yes">Option 1</property>
                                            <property name="justify">center</property>
                                            <attributes>
                                              <attribute name="font-desc" value="DejaVu Serif 13"/>
                                              <attribute name="weight" value="bold"/>
                                              <attribute name="foreground" value="#1a1a5f5fb4b4"/>
                                            </attributes>
                                          </object>
                                          <packing>
                                            <property name="expand">False</property>
                                            <property name="fill">True</property>
                                            <property name="position">2</property>
                                          </packing>
                                        </child>
                                        <child>
                                          <object class="GtkLabel">
                                            <property name="visible">True</property>
                                            <property name="can-focus">False</property>
                                            <property name="halign">start</property>
                                            <property name="valign">center</property>
                                            <property name="label" translatable="yes">If you want to run them as if they were on standard motors.
    * Use Sp0 for the main spindle, and
    * Use Sp1 for the rosette phaser/multiplier.

This will also give you the ability to run or index them using the panel to the right side of the system.
</property>
                                            <property name="wrap">True</property>
                                            <attributes>
                                              <attribute name="font-desc" value="DejaVu Serif 10"/>
                                            </attributes>
                                          </object>
                                          <packing>
                                            <property name="expand">False</property>
                                            <property name="fill">True</property>
                                            <property name="position">3</property>
                                          </packing>
                                        </child>
                                        <child>
                                          <object class="GtkLabel">
                                            <property name="visible">True</property>
                                            <property name="can-focus">False</property>
                                            <property name="halign">start</property>
                                            <property name="valign">start</property>
                                            <property name="hexpand">True</property>
                                            <property name="label" translatable="yes">Option 2</property>
                                            <property name="justify">center</property>
                                            <attributes>
                                              <attribute name="font-desc" value="DejaVu Serif 13"/>
                                              <attribute name="weight" value="bold"/>
                                              <attribute name="foreground" value="#1a1a5f5fb4b4"/>
                                            </attributes>
                                          </object>
                                          <packing>
                                            <property name="expand">False</property>
                                            <property name="fill">True</property>
                                            <property name="position">4</property>
                                          </packing>
                                        </child>
                                        <child>
                                          <object class="GtkLabel">
                                            <property name="visible">True</property>
                                            <property name="can-focus">False</property>
                                            <property name="halign">start</property>
                                            <property name="valign">center</property>
                                            <property name="label" translatable="yes">You can also use an angular axis to drive the motion.  Usually, this is C as that rotates about the Z axis, but it could also be A or B.  This is the approach needed if you need to coordinate the spindles' movement with other axes, such as when using a Gcode program.</property>
                                            <property name="wrap">True</property>
                                            <attributes>
                                              <attribute name="font-desc" value="DejaVu Serif 10"/>
                                            </attributes>
                                          </object>
                                          <packing>
                                            <property name="expand">False</property>
                                            <property name="fill">True</property>
                                            <property name="position">5</property>
                                          </packing>
                                        </child>
                                        <child>
                                          <object class="GtkLabel">
                                            <property name="visible">True</property>
                                            <property name="can-focus">False</property>
                                            <property name="halign">start</property>
                                            <property name="valign">start</property>
                                            <property name="margin-top">16</property>
                                            <property name="hexpand">True</property>
                                            <property name="label" translatable="yes">Expansion Box Notes</property>
                                            <property name="justify">center</property>
                                            <attributes>
                                              <attribute name="font-desc" value="DejaVu Serif 16"/>
                                              <attribute name="weight" value="bold"/>
                                              <attribute name="foreground" value="#1a1a5f5fb4b4"/>
                                            </attributes>
                                          </object>
                                          <packing>
                                            <property name="expand">False</property>
                                            <property name="fill">True</property>
                                            <property name="position">6</property>
                                          </packing>
                                        </child>
                                        <child>
                                          <object class="GtkLabel">
                                            <property name="visible">True</property>
                                            <property name="can-focus">False</property>
                                            <property name="halign">start</property>
                                            <property name="valign">center</property>
                                            <property name="label" translatable="yes">The base box has channels 00-05, limit switch jacks 1-3, the E-stop button, and the signal tower. The optional expansion box adds channels 06-09 and limit switch jacks 4-6. Each plug's number matches its channel number.

Only tick &lt;b&gt;Connected&lt;/b&gt; if the expansion box is plugged in. When it is ticked, LinuxCNC looks for the expansion box when it starts, and if it can't find it, LinuxCNC will fail to start. If that happens, untick Connected here and start LinuxCNC again.

Make sure the expansion box's Ethernet and power cables are both connected.

Ticking or unticking Connected takes effect the next time LinuxCNC starts.

Without the expansion box, its channels and limit switch jacks are greyed out and the axes on them can't be used. They keep their assignments, ready for when an expansion box is connected. Choosing one of those axes on a base box channel swaps the two, so the axis that was on the base box channel moves to the expansion box channel. For example, if Sp0 is on channel 06 and W is on channel 04, choosing Sp0 for channel 04 puts W on channel 06.
</property>
                                            <property name="use-markup">True</property>
                                            <property name="wrap">True</property>
                                            <attributes>
                                              <attribute name="font-desc" value="DejaVu Serif 10"/>
                                            </attributes>
                                          </object>
                                          <packing>
                                            <property name="expand">False</property>
                                            <property name="fill">True</property>
                                            <property name="position">7</property>
                                          </packing>
                                        </child>
                                        <child>
                                          <object class="GtkButton" id="Expansion_Box_How_Link">
                                            <property name="label" translatable="yes">How the Expansion Box Works</property>
                                            <property name="visible">True</property>
                                            <property name="can-focus">True</property>
                                            <property name="receives-default">True</property>
                                            <property name="tooltip-text" translatable="yes">Opens the User Manual section on the base box and the expansion box.</property>
                                            <property name="halign">start</property>
                                            <property name="margin-top">4</property>
                                            <property name="margin-bottom">6</property>
                                            <signal name="clicked" handler="Open_Manual_Link" swapped="no"/>
                                          </object>
                                          <packing>
                                            <property name="expand">False</property>
                                            <property name="fill">True</property>
                                            <property name="position">8</property>
                                          </packing>
                                        </child>
                                      </object>
                                    </child>
                                  </object>
                                </child>

                                              <attribute name="font-desc" value="DejaVu Serif 10"/>
                                              <attribute name="weight" value="bold"/>
                                            </attributes>
                                          </object>
                                        </child>
                                      </object>
                                      <packing>
                                        <property name="left-attach">1</property>
                                        <property name="top-attach">5</property>
                                      </packing>

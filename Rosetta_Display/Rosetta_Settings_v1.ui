                                            <property name="orientation">vertical</property>
                                            <child>
                                              <object class="GtkCheckButton" id="Signal_Tower_Connected">
                                                <property name="label" translatable="yes">Connected</property>
                                                <property name="visible">True</property>
                                                <property name="can-focus">False</property>
                                                <property name="receives-default">False</property>
                                                <property name="tooltip-text" translatable="yes">Check when a signal tower is plugged into the signal tower (GX-12/4) plug. Green is lit while a program or MDI command is running; red is lit after a following error or a tripped limit switch, with a short sound from the buzzer when it comes on. Takes effect the next time LinuxCNC starts.</property>
                                                <property name="halign">start</property>
                                                <property name="valign">center</property>
                                                <property name="draw-indicator">True</property>

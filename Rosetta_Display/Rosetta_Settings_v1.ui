                                                <property name="can-focus">False</property>
                                                <property name="receives-default">False</property>
                                                <property name="tooltip-text" translatable="yes">Check when a normally-closed E-stop button is plugged into the E-stop (GX-16/2) plug. Leave unchecked when nothing is plugged in - an empty plug that's marked connected holds the machine in E-stop. Takes effect the next time LinuxCNC starts.</property>
                                                <property name="halign">center</property>

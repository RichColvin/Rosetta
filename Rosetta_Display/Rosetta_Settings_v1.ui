                                          <object class="GtkLabel">
                                            <property name="visible">True</property>
                                            <property name="can-focus">False</property>
                                            <property name="label" translatable="yes">Done / Pause Beeps</property>
                                            <attributes>
                                              <attribute name="font-desc" value="DejaVu Serif 10"/>
                                              <attribute name="weight" value="bold"/>
                                            </attributes>
                                          </object>
                                        </child>
                                      </object>
                                      <packing>
                                        <property name="left-attach">1</property>
                                        <property name="top-attach">6</property>
                                      </packing>
                                    </child>
                                    <child>
                                      <object class="GtkFrame">
                                        <property name="visible">True</property>
                                        <property name="can-focus">False</property>
                                        <property name="label-xalign">0</property>
                                        <child>
                                          <object class="GtkComboBoxText" id="Fault_Sound">
                                            <property name="visible">True</property>
                                            <property name="can-focus">False</property>
                                            <property name="tooltip-text" translatable="yes">Where to sound the 3-second fault siren, which goes off when a following error or a tripped limit switch turns the signal tower red. Tower buzzer uses the signal tower (only if one is connected); Speaker uses the Pi\'s own sound (HDMI monitor or USB speaker). Takes effect the next time LinuxCNC starts.</property>
                                            <property name="halign">center</property>
                                            <property name="valign">center</property>
                                            <items>
                                              <item id="off" translatable="yes">Off</item>
                                              <item id="tower" translatable="yes">Tower buzzer</item>
                                              <item id="speaker" translatable="yes">Speaker</item>
                                              <item id="both" translatable="yes">Both</item>
                                            </items>
                                            <signal name="changed" handler="Fault_Sound_Changed" swapped="no"/>
                                          </object>
                                        </child>
                                        <child type="label">
                                          <object class="GtkLabel">
                                            <property name="visible">True</property>
                                            <property name="can-focus">False</property>
                                            <property name="label" translatable="yes">Fault Siren</property>

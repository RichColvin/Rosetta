                                        <property name="label" translatable="yes">Enable it automatically</property>
                                        <property name="visible">True</property>
                                        <property name="can-focus">False</property>
                                        <property name="receives-default">False</property>
                                        <property name="tooltip-text" translatable="yes">Turns the axis's or spindle's ENA on by itself and carries on, with no box.</property>
                                        <property name="halign">start</property>
                                        <property name="draw-indicator">True</property>
                                        <property name="group">Not_Enabled_Ask</property>
                                        <signal name="toggled" handler="Not_Enabled_Toggled" swapped="no"/>

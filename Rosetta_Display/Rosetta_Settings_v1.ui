                                              <object class="GtkRadioButton" id="Limit_Switch_NC">
                                                <property name="visible">True</property>
                                                <property name="can-focus">False</property>
                                                <property name="receives-default">False</property>
                                                <property name="tooltip-text" translatable="yes">Normally-closed switches (strongly recommended): the circuit is closed until the axis reaches the switch. A broken wire or an unplugged switch then reads as a tripped limit, so a wiring fault stops the machine instead of hiding. Applies to all the limit jacks (1-6). Takes effect the next time LinuxCNC starts.</property>
                                                <property name="halign">start</property>
                                                <property name="draw-indicator">True</property>
                                                <signal name="toggled" handler="Limit_Switch_Type_Toggled" swapped="no"/>
                                                <child>
                                                  <object class="GtkLabel">
                                                    <property name="visible">True</property>
                                                    <property name="can-focus">False</property>
                                                    <property name="label" translatable="yes">Normally closed (NC) - recommended</property>
                                                    <attributes>
                                                      <attribute name="weight" value="bold"/>
                                                    </attributes>
                                                  </object>
                                                </child>
                                              </object>
                                              <packing>
                                                <property name="expand">False</property>
                                                <property name="fill">True</property>
                                                <property name="position">0</property>
                                              </packing>
                                            </child>
                                            <child>
                                              <object class="GtkRadioButton" id="Limit_Switch_NO">
                                                <property name="label" translatable="yes">Normally open (NO)</property>
                                                <property name="visible">True</property>
                                                <property name="can-focus">False</property>
                                                <property name="receives-default">False</property>
                                                <property name="tooltip-text" translatable="yes">Normally-open switches: the circuit closes when the axis reaches the switch. Not recommended - a broken wire or an unplugged switch reads as fine, so that limit silently stops working. Applies to all the limit jacks (1-6). Takes effect the next time LinuxCNC starts.</property>
                                                <property name="halign">start</property>
                                                <property name="draw-indicator">True</property>
                                                <property name="group">Limit_Switch_NC</property>
                                                <signal name="toggled" handler="Limit_Switch_Type_Toggled" swapped="no"/>
                                              </object>
                                              <packing>
                                                <property name="expand">False</property>
                                                <property name="fill">True</property>
                                                <property name="position">1</property>
                                              </packing>

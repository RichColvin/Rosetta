#                                              Rosetta_Generate_Local_Ini.py
# ********************************************************************
#  Added 13 September 2026 - any of X,Z,U,V,W,A,B,C,Sp0,Sp1 can
#  now be assigned to any of the 8 physical channels (see CLAUDE.md).
#  This block mirrors AXIS_B's shape exactly. The "08" channel number
#  and [JOINT_8] ini section below are placeholders only - never a real
#  hm2 channel (only 00-07 exist) - Rosetta_Generate_Local_Ini.py rewrites
#  both to A's real, currently-computed channel/joint number if the
#  operator ever assigns A to a channel via the Axis Selection tab, and
#  omits this entire block from the generated Rosetta.local.hal whenever A
#  isn't currently assigned to any channel (as in the shipped default).
# ********************************************************************

# ROLE_BLOCK_START: A
addf pid.a.do-pid-calcs                     servo-thread

# ********************************************************************
#  Connect signals to pins

# A now has its own panel ENA-toggle button (A_ENA on Rosetta_Panel_v1.ui,
# added 18 September 2026) driving a dedicated "a-enable" signal via
# Rosetta_PostGUI_v1.hal's a-ena-flip/a-ena-and/a-estop-and chain, the same
# pattern every other axis letter already uses - see that file for the
# full chain (panel toggle AND settings-tab override AND machine-is-on).
net a-enable                             => hm2_7i92.0.outm.00.out-08
net a-enable                             => hm2_7i92.0.stepgen.08.enable
net a-enable                             => pid.a.enable

net a-output                            <=  pid.a.output
net a-output                             => hm2_7i92.0.stepgen.08.velocity-cmd

net a-pos-cmd                           <=  joint.8.motor-pos-cmd
net a-pos-cmd                            => pid.a.command

net a-pos-fb                            <=  hm2_7i92.0.stepgen.08.position-fb
net a-pos-fb                             => joint.8.motor-pos-fb
net a-pos-fb                             => pid.a.feedback

# ********************************************************************
#  Set pin values
setp hm2_7i92.0.stepgen.08.dirsetup         [JOINT_8]DIRSETUP
setp hm2_7i92.0.stepgen.08.dirhold          [JOINT_8]DIRHOLD
setp hm2_7i92.0.stepgen.08.steplen          [JOINT_8]STEPLEN
setp hm2_7i92.0.stepgen.08.stepspace        [JOINT_8]STEPSPACE
setp hm2_7i92.0.stepgen.08.step_type        0
setp hm2_7i92.0.stepgen.08.control-type     1
setp hm2_7i92.0.stepgen.08.maxaccel         [JOINT_8]STEPGEN_MAXACCEL
setp hm2_7i92.0.stepgen.08.maxvel           [JOINT_8]STEPGEN_MAXVEL

setp pid.a.error-previous-target            true

setp pid.a.bias                             [JOINT_8]BIAS
setp pid.a.deadband                         [JOINT_8]DEADBAND
setp pid.a.maxoutput                        [JOINT_8]MAX_OUTPUT


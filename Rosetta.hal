#  Axis  Joint  Channel   Type     Seq  Plug  Comments
#  ----  -----  -------  -------  ----  ----  ------------------------
#   V      4       03    LINEAR     4    P14
# ********************************************************************
#  Modified 13 July 2026
# ********************************************************************

# ROLE_BLOCK_START: V
addf pid.v.do-pid-calcs                     servo-thread

# ********************************************************************
#  Connect signals to pins

# See also the Rosetta_PostGUI_v1.hal
net v-enable                             => hm2_7i92.0.outm.00.out-03
net v-enable                             => hm2_7i92.0.stepgen.03.enable
net v-enable                             => pid.v.enable

net v-output                            <=  pid.v.output
net v-output                             => hm2_7i92.0.stepgen.03.velocity-cmd

net v-pos-cmd                           <=  joint.4.motor-pos-cmd
net v-pos-cmd                            => pid.v.command

net v-pos-fb                            <=  hm2_7i92.0.stepgen.03.position-fb
net v-pos-fb                             => joint.4.motor-pos-fb
net v-pos-fb                             => pid.v.feedback

# ********************************************************************
#  Set pin values
setp hm2_7i92.0.stepgen.03.dirsetup         [JOINT_4]DIRSETUP
setp hm2_7i92.0.stepgen.03.dirhold          [JOINT_4]DIRHOLD
setp hm2_7i92.0.stepgen.03.steplen          [JOINT_4]STEPLEN
setp hm2_7i92.0.stepgen.03.stepspace        [JOINT_4]STEPSPACE
setp hm2_7i92.0.stepgen.03.step_type        0
setp hm2_7i92.0.stepgen.03.control-type     1
setp hm2_7i92.0.stepgen.03.maxaccel         [JOINT_4]STEPGEN_MAXACCEL
setp hm2_7i92.0.stepgen.03.maxvel           [JOINT_4]STEPGEN_MAXVEL

setp pid.v.error-previous-target            true

setp pid.v.bias                             [JOINT_4]BIAS
setp pid.v.deadband                         [JOINT_4]DEADBAND
setp pid.v.maxoutput                        [JOINT_4]MAX_OUTPUT

# ********************************************************************
# ROLE_BLOCK_END: V
#    AA    XX    XX IIIIIIII  SSSSSS      WW       WW
#   AAAA    XX  XX    II     SS    SS     WW       WW
#  AA  AA    XXXX     II      SSS         WW   W   WW
# AAAAAAAA   XXXX     II         SSS       WW WWW WW
# AA    AA  XX  XX    II     SS    SS       WWW WWW
# AA    AA XX    XX IIIIIIII  SSSSSS         W   W
# ********************************************************************
#
# Configuration values
#                                 Home   PCB
#  Axis  Joint  Channel   Type     Seq  Plug  Comments
#  ----  -----  -------  -------  ----  ----  ------------------------
#   W      5       00    LINEAR     5    P11
# ********************************************************************
#  Modified 13 July 2026
# ********************************************************************

# ROLE_BLOCK_START: W
addf pid.w.do-pid-calcs                     servo-thread

# ********************************************************************
#  Connect signals to pins

# See also the Rosetta_PostGUI_v1.hal
net w-enable                             => hm2_7i92.0.outm.00.out-00
net w-enable                             => hm2_7i92.0.stepgen.00.enable
net w-enable                             => pid.w.enable

net w-pos-cmd                           <=  joint.5.motor-pos-cmd
net w-pos-cmd                            => pid.w.command

net w-pos-fb                            <=  hm2_7i92.0.stepgen.00.position-fb
net w-pos-fb                             => joint.5.motor-pos-fb
net w-pos-fb                             => pid.w.feedback

net w-output                            <=  pid.w.output
net w-output                             => hm2_7i92.0.stepgen.00.velocity-cmd

# ********************************************************************
#  Set pin values
setp hm2_7i92.0.stepgen.00.dirsetup         [JOINT_5]DIRSETUP
setp hm2_7i92.0.stepgen.00.dirhold          [JOINT_5]DIRHOLD
setp hm2_7i92.0.stepgen.00.steplen          [JOINT_5]STEPLEN
setp hm2_7i92.0.stepgen.00.stepspace        [JOINT_5]STEPSPACE
setp hm2_7i92.0.stepgen.00.step_type        0
setp hm2_7i92.0.stepgen.00.control-type     1
setp hm2_7i92.0.stepgen.00.maxaccel         [JOINT_5]STEPGEN_MAXACCEL
setp hm2_7i92.0.stepgen.00.maxvel           [JOINT_5]STEPGEN_MAXVEL

setp pid.w.error-previous-target            true

setp pid.w.bias                             [JOINT_5]BIAS
setp pid.w.deadband                         [JOINT_5]DEADBAND
setp pid.w.maxoutput                        [JOINT_5]MAX_OUTPUT

# ********************************************************************
# ROLE_BLOCK_END: W
#  SSSSSS  PPPPPPP  IIIIIIII N     NN DDDDDDD  LL       EEEEEEEE   0000
# SS    SS PP    PP    II    NN    NN DD    DD LL       EE        00  00
#  SSS     PP    PP    II    NNN   NN DD    DD LL       EEEEE    00    00
#     SSS  PPPPPPP     II    NN NN NN DD    DD LL       EE       00    00
# SS    SS PP          II    NN  NNNN DD    DD LL       EE        00  00
#  SSSSSS  PP       IIIIIIII NN    NN DDDDDDD  LLLLLLLL EEEEEEEE   0000
# ********************************************************************
#
# Configuration values
#                                 Home   PCB
#  Axis  Joint  Channel   Type     Seq  Plug  Comments
#  ----  -----  -------  -------  ----  ----  ------------------------
#  Sp0     7       06      n/a     n/a   P17
# ********************************************************************
#  Modified 13 July 2026
# ********************************************************************

# ROLE_BLOCK_START: Sp0
addf orient.0                               servo-thread
addf pid.p0.do-pid-calcs                    servo-thread
addf mux2.0                                 servo-thread
addf mux2.2                                 servo-thread
addf or2.0                                  servo-thread

# ********************************************************************
#  Connect signals to pins

net machine-is-on                        => hm2_7i92.0.stepgen.06.enable

# orient.0.angle now comes through mux2.2 instead of straight from
# spindle.0.orient-angle, so it can be driven either by M19 (the normal
# single-spindle path, mux2.2.in0, sel=FALSE) or by Rosetta_main.py's
# simultaneous Sp0+Sp1 index path (mux2.2.in1, sel=TRUE) - see
# Sp0_Idx_Active/Sp1_Idx_Active in Rosetta_main.py and the matching Sp1 block
# below. orient.0.mode doesn't follow spindle.0.orient-mode (M19's P
# word): Rosetta_main.py sets it before each index (since 08 November
# 2026, SPINDLE_INDEX_MODE) so an index always turns the way of the
# button pressed - see below.
net spindle.0-orient-angle-m19          <=  spindle.0.orient-angle
net spindle.0-orient-angle-m19           => mux2.2.in0

# Sp0-idx-angle/Sp0-idx-active are only created here (readers only) -
# their driver (gladevcp.Sp0-idx-angle/-active) doesn't exist until the
# GladeVCP panel process starts, well after Rosetta.hal loads, so that net
# is added later from Rosetta_PostGUI_v1.hal instead (same reason the ENA
# override pins are wired there, not here). Until then these signals
# just sit at their default (0.0 / FALSE), which is harmless - FALSE
# selects the normal M19 path in both mux2.2 and or2.0 below.
net Sp0-idx-angle                        => mux2.2.in1

net Sp0-idx-active                       => mux2.2.sel

net orient.0-angle                      <=  mux2.2.out
net orient.0-angle                       => orient.0.angle

net orient-done                         <=  orient.0.is-oriented
net orient-done                          => spindle.0.is-oriented

net spindle.0-at-speed                   => spindle.0.at-speed

net spindle.0-cw                        <=  spindle.0.forward
net spindle.0-ccw                       <=  spindle.0.reverse

# See also the Rosetta_PostGUI_v1.hal
net spindle.0-enable                     => hm2_7i92.0.outm.00.out-06

net spindle.0-index-enable              <=> spindle.0.index-enable
net spindle.0-index-enable               => pid.p0.index-enable

net spindle.0-output-pos                <=  pid.p0.output
net spindle.0-output-pos                 => mux2.0.in1

net spindle.0-pos-cmd                   <=  orient.0.command
net spindle.0-pos-cmd                    => pid.p0.command

# spindle.0-pos-mode-enable is now the OR of the M19-driven enable
# (spindle.0.orient, or2.0.in0) and Rosetta_main.py's simultaneous
# Sp0+Sp1 index path (Sp0-idx-active, or2.0.in1 - same bit used to
# select mux2.2 above) - either path enables the same orient/PID/mux
# chain identically, only the trigger source differs.
net spindle.0-orient-m19                <=  spindle.0.orient
net spindle.0-orient-m19                 => or2.0.in0

net Sp0-idx-active                       => or2.0.in1

net spindle.0-pos-mode-enable           <=  or2.0.out
net spindle.0-pos-mode-enable            => orient.0.enable
net spindle.0-pos-mode-enable            => pid.p0.enable
net spindle.0-pos-mode-enable            => mux2.0.sel

net spindle.0-position-fb              <=  hm2_7i92.0.stepgen.06.position-fb
net spindle.0-position-fb               => orient.0.position
net spindle.0-position-fb               => pid.p0.feedback
net spindle.0-position-fb               => spindle.0.revs

net spindle.0-vel-cmd-rps               <=  spindle.0.speed-out-rps
net spindle.0-vel-cmd-rps                => mux2.0.in0

# mux2.0 selects between normal spindle speed (mux2.0.in0, sel=FALSE) and
# the orient position-PID output (mux2.0.in1, sel=TRUE while spindle.0.orient
# is active during an M19 move) - see spindle.0-pos-mode-enable above.
net spindle.0-vel-cmd-final              <=  mux2.0.out
net spindle.0-vel-cmd-final               => hm2_7i92.0.stepgen.06.velocity-cmd

net spindle.0-vel-fb-rps               <=  hm2_7i92.0.stepgen.06.velocity-fb
net spindle.0-vel-fb-rps                => spindle.0.speed-in

# ********************************************************************
#  Set pin values
setp hm2_7i92.0.stepgen.06.dirsetup         [SPINDLE_0]DIRSETUP
setp hm2_7i92.0.stepgen.06.dirhold          [SPINDLE_0]DIRHOLD
setp hm2_7i92.0.stepgen.06.steplen          [SPINDLE_0]STEPLEN
setp hm2_7i92.0.stepgen.06.stepspace        [SPINDLE_0]STEPSPACE
setp hm2_7i92.0.stepgen.06.step_type        0
setp hm2_7i92.0.stepgen.06.control-type     1
setp hm2_7i92.0.stepgen.06.maxaccel         [SPINDLE_0]STEPGEN_MAXACCEL
setp hm2_7i92.0.stepgen.06.maxvel           [SPINDLE_0]STEPGEN_MAXVEL

setp pid.p0.bias                            [SPINDLE_0]BIAS_POS
setp orient.0.tolerance                     [SPINDLE_0]ORIENT_TOLERANCE
# Starts as shortest path (see man orient); Rosetta_main.py sets 1 or 2
# before each index from the panel, so the drive's backlash is always
# taken up the same way (until 08 November 2026 it stayed 0, and an index
# of 180 degrees or more could turn against the button pressed).
setp orient.0.mode                          0
setp pid.p0.maxoutput                       [SPINDLE_0]MAX_OUTPUT_POS
setp pid.p0.maxerrorI                       [SPINDLE_0]MAX_ERROR_I_POS

# ********************************************************************
#  Set signal values
sets spindle.0-at-speed                     true

# ********************************************************************
# ROLE_BLOCK_END: Sp0

# ********************************************************************
#  SSSSSS  PPPPPPP  IIIIIIII N     NN DDDDDDD  LL       EEEEEEEE  1111
# SS    SS PP    PP    II    NN    NN DD    DD LL       EE       11 11
#  SSS     PP    PP    II    NNN   NN DD    DD LL       EEEEE       11
#     SSS  PPPPPPP     II    NN NN NN DD    DD LL       EE          11
# SS    SS PP          II    NN  NNNN DD    DD LL       EE          11
#  SSSSSS  PP       IIIIIIII NN    NN DDDDDDD  LLLLLLLL EEEEEEEE 11111111
# ********************************************************************
#
# Configuration values
#                                 Home   PCB
#  Axis  Joint  Channel   Type     Seq  Plug  Comments
#  ----  -----  -------  -------  ----  ----  ------------------------
#  Sp1     6       07      n/a     n/a   P18
# ********************************************************************
#  Modified 13 July 2026
# ********************************************************************

# ROLE_BLOCK_START: Sp1
addf orient.1                               servo-thread
addf pid.p1.do-pid-calcs                    servo-thread
addf mux2.1                                 servo-thread
addf mux2.3                                 servo-thread
addf or2.1                                  servo-thread

# ********************************************************************
#  Connect signals to pins
net machine-is-on                        => hm2_7i92.0.stepgen.07.enable

# See the matching Sp0 block above for why orient.1.angle now comes
# through mux2.3 (M19 vs Rosetta_main.py's simultaneous Sp0+Sp1 index path)
# and orient.1.mode doesn't follow spindle.1.orient-mode.
net spindle.1-orient-angle-m19          <=  spindle.1.orient-angle
net spindle.1-orient-angle-m19           => mux2.3.in0

# See the matching Sp0-idx-angle/Sp0-idx-active comment above - these
# are also wired to their gladevcp.* driver later, from Rosetta_PostGUI_v1.hal.
net Sp1-idx-angle                        => mux2.3.in1

net Sp1-idx-active                       => mux2.3.sel

net orient.1-angle                      <=  mux2.3.out
net orient.1-angle                       => orient.1.angle

net orient.1-done                       <=  orient.1.is-oriented
net orient.1-done                        => spindle.1.is-oriented

net spindle.1-at-speed                   => spindle.1.at-speed

net spindle.1-cw                        <=  spindle.1.forward
net spindle.1-ccw                       <=  spindle.1.reverse

# See also the Rosetta_PostGUI_v1.hal
net spindle.1-enable                     => hm2_7i92.0.outm.00.out-07

net spindle.1-index-enable              <=> spindle.1.index-enable
net spindle.1-index-enable               => pid.p1.index-enable

net spindle.1-output-pos                <=  pid.p1.output
net spindle.1-output-pos                 => mux2.1.in1

net spindle.1-pos-cmd                   <=  orient.1.command
net spindle.1-pos-cmd                    => pid.p1.command

# See the matching Sp0 block above - spindle.1-pos-mode-enable is now the
# OR of the M19-driven enable and Rosetta_main.py's simultaneous index path.
net spindle.1-orient-m19                <=  spindle.1.orient
net spindle.1-orient-m19                 => or2.1.in0

net Sp1-idx-active                       => or2.1.in1

net spindle.1-pos-mode-enable           <=  or2.1.out
net spindle.1-pos-mode-enable            => orient.1.enable
net spindle.1-pos-mode-enable            => pid.p1.enable
net spindle.1-pos-mode-enable            => mux2.1.sel

net spindle.1-position-fb              <=  hm2_7i92.0.stepgen.07.position-fb
net spindle.1-position-fb               => orient.1.position
net spindle.1-position-fb               => pid.p1.feedback
net spindle.1-position-fb               => spindle.1.revs

net spindle.1-vel-cmd-rps                => mux2.1.in0

# mux2.1 selects between normal spindle speed (mux2.1.in0, sel=FALSE) and
# the orient position-PID output (mux2.1.in1, sel=TRUE while spindle.1.orient
# is active during an M19 move) - see spindle.1-pos-mode-enable above.
net spindle.1-vel-cmd-final              <=  mux2.1.out
net spindle.1-vel-cmd-final               => hm2_7i92.0.stepgen.07.velocity-cmd

net spindle.1-vel-fb-rps                <=  hm2_7i92.0.stepgen.07.velocity-fb

net spindle.1-vel-cmd-rps               <=  spindle.1.speed-out-rps

net spindle.1-vel-fb-rps                 => spindle.1.speed-in

# ********************************************************************
#  Set pin values
setp hm2_7i92.0.stepgen.07.dirsetup         [SPINDLE_1]DIRSETUP
setp hm2_7i92.0.stepgen.07.dirhold          [SPINDLE_1]DIRHOLD
setp hm2_7i92.0.stepgen.07.steplen          [SPINDLE_1]STEPLEN
setp hm2_7i92.0.stepgen.07.stepspace        [SPINDLE_1]STEPSPACE
setp hm2_7i92.0.stepgen.07.step_type        0
setp hm2_7i92.0.stepgen.07.control-type     1
setp hm2_7i92.0.stepgen.07.maxaccel         [SPINDLE_1]STEPGEN_MAXACCEL
setp hm2_7i92.0.stepgen.07.maxvel           [SPINDLE_1]STEPGEN_MAXVEL

setp pid.p1.bias                            [SPINDLE_1]BIAS_POS
setp orient.1.tolerance                     [SPINDLE_1]ORIENT_TOLERANCE
# See the matching Sp0 setp above - hardwired shortest-path.
setp orient.1.mode                          0
setp pid.p1.maxoutput                       [SPINDLE_1]MAX_OUTPUT_POS
setp pid.p1.maxerrorI                       [SPINDLE_1]MAX_ERROR_I_POS

# ********************************************************************
#  Set signal values
sets spindle.1-at-speed                     true

# ********************************************************************
# ROLE_BLOCK_END: Sp1

# ********************************************************************
#  Connect miscellaneous signals to pins
# ********************************************************************
#  Modified 13 July 2026
# ********************************************************************

# E-stop: the optional E-stop button (GX-16/2 plug, normally-closed,
# between P1 pin 21 / hm2_7i92.0.gpio.031 and ground) feeds estop-latch.0's
# fault-in via the estop-button net - but only when the operator has
# marked it connected in Rosetta Settings (Axis Selection page), in which
# case Rosetta_Generate_Local_Ini.py adds the net to Rosetta.local.hal. Without
# it fault-in stays false and this chain behaves like the plain
# user-enable-out -> emc-enable-in loop it replaced. With it, pressing
# the button (or a broken wire / unplugged button) lets the 7i92's
# pull-up take the input high, which latches a fault and drops LinuxCNC
# into E-stop until the button is released AND the operator turns
# E-stop off in AXIS (F1), which pulses user-request-enable into reset.
# Since 16 October 2026 the generator always feeds fault-in through an
# OR (estop-fault-or) of the button and card-fault (any card losing
# contact: packet-error-exceeded, watchdog.has_bit) - see
# _estop_fault_hal.
addf estop-latch.0                          servo-thread

net estop-out                           <=  iocontrol.0.user-enable-out
net estop-out                            => estop-latch.0.ok-in

net estop-reset                         <=  iocontrol.0.user-request-enable
net estop-reset                          => estop-latch.0.reset

net estop-ok                            <=  estop-latch.0.ok-out
net estop-ok                             => iocontrol.0.emc-enable-in

net machine-is-on                           halui.machine.is-on

# ********************************************************************
#  Program progress
#  Added 20 October 2026
# ********************************************************************
# program-path.out adds up how far the motion planner has moved along
# the toolpath (motion.current-vel integrated: X/Y/Z length, else U/V/W,
# else A/B/C - in machine units or degrees). It only ever grows, so the
# main panel's progress bar (Rosetta_main.py, "Program progress") reads it
# at the start of a run and compares how far it has grown with the
# program's total from Rosetta_Display/Rosetta_Program_Estimate.py - which loops
# and repeated lines can't confuse, unlike line numbers.
loadrt integ names=program-path
addf program-path                           servo-thread

net program-speed                       <=  motion.current-vel
net program-speed                        => program-path.in

# ********************************************************************
#  Card write - last in the servo thread
#  Added 16 October 2026
# ********************************************************************
# Mesa's order (Peter Wallace, 16 October 2026): read, everything else,
# then write, so each cycle sends what motion and the PIDs have just
# worked out rather than the previous cycle's. Rosetta_Generate_Local_Ini.py
# moves this line in Rosetta.local.hal to after the HAL it adds (limit
# jacks, E-stop button, signal tower), and with the expansion box adds
# hm2_7i92.1.write after it. Rosetta_PostGUI_v1.hal's ENA-button logic is
# added after the GUI loads, so it still runs after this.
addf hm2_7i92.0.write                       servo-thread

# ********************************************************************
#  Restore persisted axis scale/maxvel/maxaccel/PID/backlash values
#  Added 04 September 2026
# ********************************************************************
# hm2_7i92.0.stepgen.*.position-scale/maxvel/maxaccel, pid.*.Pgain/
# Igain/Dgain/FF0/FF1/FF2/maxoutput, and joint.*.backlash are all live HAL
# PARAMETERS with no connection to Rosetta.ini/Rosetta.local.ini at all - each
# one resets to that component's own hard default (0 or 1, not this
# machine's real values) every time hm2_7i92/pid/motion are freshly
# loaded above. Before 4 September 2026, the embedded AXIS Settings
# tab's own startup pushed every persisted value from RosettaSet_v1.ini
# onto these live HAL parameters, automatically, every time LinuxCNC
# started - because the tab was embedded in AXIS itself. Once the
# Settings tab was replaced by the standalone Rosetta_Settings program
# (which must run BEFORE LinuxCNC, and is blocked from running while
# LinuxCNC is running), nothing was left to do this restore at a normal
# LinuxCNC startup at all - confirmed live 4 September 2026: every
# axis's scale and PID gains sat at hm2's own defaults for at least one
# full session, and Rosetta_Shutdown.hal's Rosetta_Scale_Persist.py then
# faithfully saved those wrong live values straight back into
# RosettaSet_v1.ini, silently overwriting real calibrated data (recovered
# afterward from an old backup - see Rosetta_Display/Rosetta_Settings_Restore.py's
# own docstring for the full story). This loadusr is the fix: the
# load-side counterpart to Rosetta_Scale_Persist.py, run here (with -w, so
# HAL loading waits for it to finish) now that hm2_7i92/pid/motion are
# all already loaded above and every pin/param it needs to setp exists.
loadusr -w python3 Rosetta_Display/Rosetta_Settings_Restore.py

# *********************** NOTHING FOLLOWS ****************************

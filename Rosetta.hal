#######################################################################
#
# ********************************************************************
# Revised Panel Plug Layout
#
#    U     V     W     B
#    X     Z    Sp0   Sp1
#
# Configuration values
#
#                                 Home   PCB
#  Axis  Joint  Channel   Type     Seq  Plug  Comments
#  ----  -----  -------  -------  ----  ----  ------------------------
#   X      0       04    LINEAR     1    P15
#   Y      -       --    ------     -         Not available as LATHE=1
#   Z      1       01    LINEAR     2    P12
#
#   A      -       08    ANGULAR    -    --   Not currently assigned to
#                                              a channel (placeholder -
#                                              any of X,Z,U,V,W,A,B,C,
#                                              Sp0,Sp1 can be assigned
#                                              to any of the 8 real
#                                              channels via the Axis
#                                              Selection tab)
#   B      2       05    ANGULAR    6    P16
#   C      -       09    ANGULAR    -    --   Not currently assigned -
#                                              see A above
#
#   U      3       02    LINEAR     3    P13
#   V      4       03    LINEAR     4    P14
#   W      5       00    LINEAR     5    P11
#
#  Sp0     7       06      n/a     n/a   P17
#  Sp1     6       07      n/a     n/a   P18  Previously the C axis
#
# Limit switches: 3 GX-12 limit jacks (normally-closed switches), each
#   optionally assigned in Rosetta Settings (Axis Selection page) to one end
#   of an axis's travel (min/max) or both ends wired in series. Every
#   joint's neg-lim-sw-in/pos-lim-sw-in is wired entirely by
#   Rosetta_Generate_Local_Ini.py (_limit_jack_hal), which knows this launch's
#   joint numbers - nothing in this template touches them, so a joint
#   with no jack keeps them false (no limit). Spindles have no limit
#   switches.
#

# ********************************************************************
# Details about the fields are available in the
#   LinuxCNC System Manual, https://linuxcnc.org/docs/stable/html/
# ********************************************************************

loadrt [KINS]KINEMATICS
loadrt [EMCMOT]EMCMOT servo_period_nsec=[EMCMOT]SERVO_PERIOD num_joints=[KINS]JOINTS num_spindles=[TRAJ]SPINDLES
loadrt hostmot2
# num_inms=0: the firmware's InM (debounced input) module is left off so
# its 8 pins (Input0-7) become plain GPIO - the limit jacks and E-stop
# button read them as hm2_7i92.0.gpio.NNN.in, and a spare one can be an
# output (the signal tower's buzzer). See Rosetta_Generate_Local_Ini.py.
# Two-box hardware: Rosetta_Generate_Local_Ini.py rewrites this line every
# launch (_card_setup_hal) - the base box's card alone, or both cards
# (10.10.10.10 and .11) on one line when an expansion box is connected,
# which also gets its own read/write and timer/watchdog setp lines below.
loadrt hm2_eth board_ip="10.10.10.10" config="num_encoders=0 num_inms=0 num_pwmgens=0 num_stepgens=6"
loadrt orient count=2
# mux2.0/mux2.1 select spindle velocity source; mux2.2/mux2.3 select the
# Sp0/Sp1 orient target angle source (M19 vs the simultaneous-index path -
# see the Sp0/Sp1 sections below).
loadrt mux2 count=4
# or2.0/or2.1 merge the M19-driven orient-enable with the simultaneous-index
# path's own trigger bit for Sp0/Sp1 respectively - see the Sp0/Sp1 sections
# below.
loadrt or2 count=2
# Latches the optional hardware E-stop button - see "E-stop" below.
loadrt estop_latch
# pid.a/pid.c added 13 September 2026 (any of X,Z,U,V,W,A,B,C,Sp0,Sp1
# can now be assigned to any of the 8 physical channels - see CLAUDE.md
# and Rosetta_Setup/Rosetta_Generate_Local_Ini.py) - loaded unconditionally
# like every other role's pid component, even on a launch where A/C
# aren't currently assigned to any channel (harmless idle, no net wired
# to them in that case - see the AXIS_A/AXIS_C blocks below).
loadrt pid names=pid.x,pid.z,pid.b,pid.a,pid.c,pid.u,pid.v,pid.w,pid.p0,pid.p1

# The card's write is added last, after motion, the PIDs and the E-stop
# chain (see "Card write" near the end of this file).
addf hm2_7i92.0.read                        servo-thread
addf motion-command-handler                 servo-thread
addf motion-controller                      servo-thread

setp hm2_7i92.0.dpll.01.timer-us            -50
setp hm2_7i92.0.stepgen.timer-number        1
setp hm2_7i92.0.watchdog.timeout_ns         5000000

# ********************************************************************
#    AA    XX    XX IIIIIIII  SSSSSS      YY    YY
#   AAAA    XX  XX    II     SS    SS      YY  YY
#  AA  AA    XXXX     II      SSS           YYYY
# AAAAAAAA   XXXX     II         SSS        XXXX
# AA    AA  XX  XX    II     SS    SS      XX   XX
# AA    AA XX    XX IIIIIIII  SSSSSS      XX     XX
# ********************************************************************
#
# Configuration values
#                                 Home   PCB
#  Axis  Joint  Channel   Type     Seq  Plug  Comments
#  ----  -----  -------  -------  ----  ----  ------------------------
#   X      0       04    LINEAR     1    P15
# ********************************************************************
#  Modified 13 July 2026
# ********************************************************************

# ROLE_BLOCK_START: X
addf pid.x.do-pid-calcs                     servo-thread

# ********************************************************************
#  Connect signals to pins

# See also the Rosetta_PostGUI_v1.hal
net x-enable                             => hm2_7i92.0.outm.00.out-04
net x-enable                             => hm2_7i92.0.stepgen.04.enable
net x-enable                             => pid.x.enable

net x-output                            <=  pid.x.output
net x-output                             => hm2_7i92.0.stepgen.04.velocity-cmd

net x-pos-cmd                           <=  joint.0.motor-pos-cmd
net x-pos-cmd                            => pid.x.command

net x-pos-fb                            <=  hm2_7i92.0.stepgen.04.position-fb
net x-pos-fb                             => joint.0.motor-pos-fb
net x-pos-fb                             => pid.x.feedback

# ********************************************************************
#  Set pin values
setp hm2_7i92.0.stepgen.04.dirsetup         [JOINT_0]DIRSETUP
setp hm2_7i92.0.stepgen.04.dirhold          [JOINT_0]DIRHOLD
setp hm2_7i92.0.stepgen.04.steplen          [JOINT_0]STEPLEN
setp hm2_7i92.0.stepgen.04.stepspace        [JOINT_0]STEPSPACE
setp hm2_7i92.0.stepgen.04.step_type        0
setp hm2_7i92.0.stepgen.04.control-type     1
setp hm2_7i92.0.stepgen.04.maxaccel         [JOINT_0]STEPGEN_MAXACCEL
setp hm2_7i92.0.stepgen.04.maxvel           [JOINT_0]STEPGEN_MAXVEL

setp pid.x.error-previous-target            true

setp pid.x.bias                             [JOINT_0]BIAS
setp pid.x.deadband                         [JOINT_0]DEADBAND
setp pid.x.maxoutput                        [JOINT_0]MAX_OUTPUT

